# ==============================================================================
# HisabKhata PRO - Node.js Backend & SMTP Configuration
# ==============================================================================

# Server Port
PORT=5000

# Custom SMTP Configuration
# Examples:
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# For Custom Domain / cPanel: SMTP_HOST=mail.yourdomain.com, SMTP_PORT=465 or 587
# For Brevo/Sendinblue: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password

# Sender Details
SMTP_FROM_NAME=HisabKhata PRO
SMTP_FROM_EMAIL=noreply@sumanonline.com

# Allowed CORS Origins (Comma-separated or * for development)
CORS_ORIGIN=*
